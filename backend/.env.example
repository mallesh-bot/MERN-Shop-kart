# ========================================================
# ShopKart Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with real values.
# NEVER commit your actual .env file to version control.
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Client Origin for CORS
# In local development: http://localhost:5173
# In production: https://<your-frontend-domain>.pages.dev (or vercel.app)
CLIENT_URL=http://localhost:5173

# MongoDB Database Connection String
# Automated fallback to local mongodb://127.0.0.1:27017/shopkart occurs if Atlas is unreachable
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopkart?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 random characters recommended)
JWT_SECRET=your_super_secret_jwt_key_here

# Razorpay Test Mode API Credentials (Obtain from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourKeySecretHere
